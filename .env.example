# Copy this file to ".env" and fill in. NEVER commit ".env" (it is in .gitignore).
# Leave the key empty to use free OpenStreetMap data (no card needed).
GOOGLE_PLACES_API_KEY=
# google | osm  (default: google if a key is set, otherwise osm)
PROVIDER=
# Google returns 20 results per page. Each page = 1 billable request. Keep low.
MAX_REQUESTS=40
GRID=2
SPLIT_AT=40
MAX_DEPTH=4
SITE_PHOTOS=true
PORT=3000
# Photos for generated sites. Order: Google Maps photos -> stock photos -> generated illustration.
# Optional free keys for better stock photos (without them, free Wikimedia Commons images are used):
#   Pexels:   https://www.pexels.com/api/   Unsplash: https://unsplash.com/developers
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
STOCK_PHOTOS=true